# API env. Copy to `apps/api/.env` (git-ignored). Values are DEV-ONLY placeholders; no real secrets here.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:5173
ATTACHMENTS_DIR=./.data/attachments
# Cookie signing secret: at least 32 characters. Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-random-string-of-32-or-more-chars

# Runtime connection: DML-only role tradex_app (passwords match .env.example defaults).
DATABASE_URL=postgresql://tradex_app:tradex_app_dev_only@127.0.0.1:5432/tradex_dev
# Integration tests run against the separate test database.
DATABASE_URL_TEST=postgresql://tradex_app:tradex_app_dev_only@127.0.0.1:5432/tradex_test
# Migrations (Phase 03) run as the DDL role tradex_owner.
DATABASE_URL_MIGRATE=postgresql://tradex_owner:tradex_owner_dev_only@127.0.0.1:5432/tradex_dev
# Integration tests: owner role on tradex_test (reset schema, run migrations, truncate between tests).
DATABASE_URL_TEST_MIGRATE=postgresql://tradex_owner:tradex_owner_dev_only@127.0.0.1:5432/tradex_test
