# Root env for deploy/compose.dev.yml. Copy to `.env` (git-ignored) only to override the defaults.
# These are DEV-ONLY placeholders for a database bound to 127.0.0.1. Never put real secrets in this file.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only
TRADEX_OWNER_PASSWORD=tradex_owner_dev_only
TRADEX_APP_PASSWORD=tradex_app_dev_only
